{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/qypvip/knowflow-nexus/schema/feedback-record.schema.json",
  "title": "Feedback Record",
  "description": "反馈记录 —— 预测→现实对比，驱动自进化的核心数据结构",
  "type": "object",
  "required": ["id", "task_id", "domain", "prediction_date", "prediction", "actual", "correct"],
  "properties": {
    "id": {
      "type": "string",
      "description": "反馈记录唯一标识"
    },
    "task_id": {
      "type": "string",
      "description": "关联的任务/预测 ID"
    },
    "domain": {
      "type": "string",
      "description": "领域标签（football, stock, gaokao, weather 等）"
    },
    "prediction_date": {
      "type": "string",
      "format": "date",
      "description": "预测日期"
    },
    "feedback_date": {
      "type": "string",
      "format": "date-time",
      "description": "反馈记录日期（结果出来时）"
    },
    "prediction": {
      "type": "object",
      "description": "预测内容（领域相关）",
      "required": ["value", "confidence"],
      "properties": {
        "value": { "description": "预测值，类型随领域变化（比分/涨跌/院校）" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "actual": {
      "type": "object",
      "description": "实际结果（领域相关）"
    },
    "correct": {
      "type": "boolean",
      "description": "预测是否正确"
    },
    "error_type": {
      "type": "string",
      "description": "错误类型分析",
      "enum": ["overestimate", "underestimate", "direction-wrong", "timing-wrong", "data-missing", "other"]
    },
    "data_source_accuracy": {
      "type": "object",
      "description": "各个数据源/策略在本轮中的准确率",
      "additionalProperties": { "type": "number" }
    },
    "parameter_adjustments": {
      "type": "object",
      "description": "推荐参数调整",
      "additionalProperties": { "type": "number" }
    },
    "notes": {
      "type": "string",
      "description": "人工备注/学习笔记"
    }
  }
}
